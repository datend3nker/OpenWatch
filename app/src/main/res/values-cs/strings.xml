    <string name="settings_watch_live_readings">Živá měření</string>
    <string name="settings_watch_live_readings_body">Přenáší z hodinek srdeční tep a kroky, dokud jsou připojené, pro přehled. Spotřebuje víc baterie hodinek.</string>
    <string name="settings_watch_live_now">Nyní: %1$d tep/min</string>
    <string name="settings_watch_auto_sync">Automatická synchronizace</string>
    <string name="settings_watch_auto_sync_body">Synchronizuje hodinky samo, takže spánek a aktivita dorazí i bez otevření aplikace. Hodinky musí být v dosahu a přesný okamžik určuje Android, takže se běh může trochu opozdit. Vypnuto znamená, že se hodinky synchronizují jen na vyžádání.</string>
    <string name="settings_watch_auto_sync_off">Vypnuto</string>
    <string name="settings_watch_auto_sync_30m">30 min</string>
    <string name="settings_watch_auto_sync_1h">1 h</string>
    <string name="settings_watch_auto_sync_2h">2 h</string>
    <string name="settings_watch_stay_connected">Zůstat připojeno</string>
    <string name="settings_watch_stay_connected_body">Udržuje spojení s hodinkami, kdykoli jsou v dosahu. Hodinky pak mohou stahovat počasí, najít tento telefon a předat nové záznamy hned, jak skončí — za cenu vyšší spotřeby baterie hodinek i telefonu.</string>
    <string name="settings_watch_high_mtu">Velké Bluetooth pakety</string>
    <string name="settings_watch_high_mtu_body">Žádá hodinky o větší Bluetooth pakety, díky čemuž je synchronizace mnohem rychlejší. Vypněte, pokud hodinky stále ztrácejí spojení nebo se synchronizace nikdy nerozběhne.</string>
