    <string name="settings_watch_notifications_title">Posílat oznámení na hodinky</string>
    <string name="settings_watch_notifications_body">Oznámení z telefonu se objeví na zápěstí. Čtou se v tomto zařízení a odesílají se jen na tyto hodinky.</string>
    <string name="settings_watch_notifications_grant">Povolit přístup k oznámením</string>
    <string name="settings_watch_notifications_grant_body">Android o to žádá na vlastní obrazovce nastavení. OpenWatch o to odsud požádat nemůže.</string>
    <string name="settings_watch_notifications_apps_none">Na hodinky posílají všechny aplikace</string>
    <plurals name="settings_watch_notifications_apps_blocked">
