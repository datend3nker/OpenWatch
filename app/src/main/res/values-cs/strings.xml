        <item quantity="many">%1$d aplikace umlčeno</item>
        <item quantity="other">%1$d aplikací umlčeno</item>
    </plurals>
    <string name="settings_watch_notifications_apps_intro">Vypněte aplikaci, aby její oznámení nechodila na hodinky. Všechno ostatní chodí dál.</string>
    <string name="settings_watch_notifications_apps_empty">Nebyly nalezeny žádné aplikace.</string>
    <string name="settings_watch_notifications_disclosure_title">OpenWatch bude číst vaše oznámení</string>
    <string name="settings_watch_notifications_disclosure_body">Aby mohl OpenWatch zobrazovat oznámení na hodinkách, čte oznámení, která váš telefon dostává — včetně jejich textu.\n\nČtou se v tomto zařízení a odesílají se přes Bluetooth jen na hodinky, které jste spárovali. Nic se neukládá do souboru ani do databáze a OpenWatch nemá oprávnění k internetu, takže oznámení nelze poslat nikam jinam.\n\nKdykoli to můžete vypnout a přístup k oznámením odebrat v nastavení Androidu.</string>
    <string name="settings_watch_notifications_disclosure_accept">Pokračovat</string>
    <string name="settings_watch_notifications_disclosure_decline">Teď ne</string>
    <string name="settings_watches_intro">Zkopíruje do OpenWatch to, co hodinky zaznamenaly. Nic se neposílá na internet.</string>
    <string name="settings_watches_empty_title">Žádné spárované hodinky</string>
    <string name="settings_watches_empty_body">Spárování hodinek umožní OpenWatch zkopírovat, co zaznamenaly — fáze spánku, klidový tep, stres a Body Battery — aniž by se cokoli posílalo na internet.</string>
    <string name="settings_watches_add">Spárovat hodinky</string>
    <string name="settings_watches_scan_empty">Zatím nebyly nalezeny žádné hodinky. Ověřte, že jsou probuzené a blízko telefonu.</string>
    <string name="settings_watch_pair_title">Spárovat tyto hodinky</string>
    <string name="settings_watch_pair_body">OpenWatch se s hodinkami spáruje a pak zkopíruje jejich zaznamenané soubory s aktivitou, spánkem a zdravím. Až se objeví kód na hodinkách, potvrďte ho.</string>
